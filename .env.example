# Root-level .env consumed by docker-compose.yml on the VPS.
# Generate strong values for the production deploy.

# Meta database password
META_DB_PASSWORD=change-me-strong-password

# JWT signing secret (long random string)
JWT_SECRET=change-me-very-long-random-string

# Public hostname users will connect to. Used in every connection URL the dashboard hands out.
# In prod: your VPS hostname or IP, e.g. dbaas.example.com
# IMPORTANT: Mongo databases are served on ONE shared port with per-database
# hostnames — you MUST add a wildcard DNS record pointing at this host:
#   *.mongo.<VPS_HOST>  ->  <VPS IP>
VPS_HOST=ourvps.com

# Shared public Postgres port — ONE port for ALL Postgres databases; the
# backend's pgGateway routes by username. Default 5433 (first port of the old
# published range, so upgrades can't collide with other services).
PG_PUBLIC_PORT=5433

# 32 raw bytes, base64-encoded — used to encrypt per-DB credentials.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENC_KEY=

# Where the browser can reach the frontend (used for CORS on the backend).
FRONTEND_ORIGIN=https://dbaas.example.com

# Public URL of the backend API (used by the frontend at build/run time).
PUBLIC_API_URL=https://api.dbaas.example.com

# Shared Mongo gateway. Point wildcard DNS for *.mongo.<your-domain> to the VPS.
# New Mongo databases use <random>.mongo.<your-domain>:27017 instead of one
# public port per database. Set MONGO_GATEWAY_ENABLED=false to use legacy ports.
MONGO_GATEWAY_ENABLED=true
MONGO_GATEWAY_DOMAIN=mongo.dbaas.example.com
MONGO_GATEWAY_PORT=27017

# Self-hosted Redis password. REQUIRED — Redis with no auth on the public
# internet gets pwned within hours. Generate: openssl rand -base64 24
REDIS_PASSWORD=change-me-strong-redis-password

# Password reset email. Use SMTP_URL OR SMTP_HOST/SMTP_PORT/SMTP_USER/SMTP_PASS.
# If omitted, reset links are logged by the backend for local development.
MAIL_FROM="CustomDB <no-reply@example.com>"
SMTP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional per-user caps. Leave empty for unlimited (self-hosted internal use).
DB_LIMIT=
STORAGE_LIMIT_GB=

# ─────────────────────────────────────────────────────────────────────────────
# Operate console (merged from PivotDB) — connections, explore, monitor,
# migrate, sync, backup/restore, alerts.
# ─────────────────────────────────────────────────────────────────────────────

# AES-256-GCM key encrypting stored connection URIs. 64-char hex.
#   Generate: openssl rand -hex 32
#
# NOTE this is a DIFFERENT key from CREDENTIAL_ENC_KEY above (which encrypts
# provisioned-database passwords, and is base64). Both are required.
#
# ⚠ If you are importing an existing PivotDB dataset, this MUST be that
#   deployment's original ENCRYPTION_KEY. A different key leaves every
#   imported connection URI permanently undecryptable.
ENCRYPTION_KEY=

# AES-256-GCM key for backup archives. 64-char hex.
#   Generate: openssl rand -hex 32
# Leave empty to write backups as plain .tar.gz instead.
#
# ⚠ Lose this and every encrypted backup is unreadable forever. Store it the
#   way you'd store a master password.
BACKUP_ENCRYPTION_KEY=

# Timezone used to interpret cron schedules for backup jobs.
# Examples: UTC | Asia/Kolkata | America/New_York
SCHEDULER_TZ=UTC

# Grafana — renders the charts embedded in the Monitor page.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-strong-password
# Where the BROWSER can reach Grafana. Must be publicly resolvable, because
# the Monitor page embeds it in an iframe from the user's browser.
#
# Grafana is NOT host-published — it is routed through the reverse proxy like
# the dashboard and API. Give the `grafana` service a domain in your proxy
# (in Coolify: the service's Domains field) and set this to match. Until you
# do, everything works except the charts embedded in the Monitor page.
GRAFANA_PUBLIC_URL=https://grafana.dbaas.example.com

# How long Prometheus keeps metrics history.
PROMETHEUS_RETENTION=30d
