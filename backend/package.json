{
  "name": "customdb-backend",
  "version": "0.2.0",
  "description": "CustomDB unified API — provisioning engine + PivotDB migrate/sync/backup/monitor",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:reset": "prisma migrate reset",
    "import:pivotdb": "tsx prisma/import/import-pivotdb.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/lib-storage": "^3.600.0",
    "@prisma/client": "^5.22.0",
    "@vlasky/zongji": "^0.6.1",
    "adm-zip": "^0.5.17",
    "archiver": "^8.0.0",
    "bcrypt": "^5.1.1",
    "bson": "^7.0.0",
    "bullmq": "^5.12.0",
    "cors": "^2.8.5",
    "csv-parse": "^6.2.1",
    "csv-stringify": "^6.5.1",
    "dockerode": "^4.0.2",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.2.0",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "mysql2": "^3.22.3",
    "node-cron": "^3.0.3",
    "nodemailer": "^9.0.3",
    "otplib": "^12.0.1",
    "pg": "^8.21.0",
    "pg-copy-streams": "^7.0.0",
    "pg-logical-replication": "^2.4.0",
    "pg-query-stream": "^4.15.0",
    "prisma": "^5.22.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "socket.io": "^4.7.5",
    "tar": "^7.4.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.12",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.20.0",
    "@types/pg-copy-streams": "^1.2.5",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
