# Meta database (the platform's own Postgres — NOT user-provisioned DBs)
DATABASE_URL="postgresql://customdb:customdb@localhost:5432/customdb_meta?schema=public"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Platform admin account — seeded (or promoted) on backend boot.
# Sign in with these credentials to access the /admin dashboard.
ADMIN_EMAIL="admin@customdb.local"
ADMIN_PASSWORD="change-me-strong-password"

# Google OAuth sign-in. Create OAuth 2.0 credentials at
# https://console.cloud.google.com/apis/credentials and add
#   {FRONTEND_ORIGIN}/api/auth/google/callback
# as an authorized redirect URI. Leave blank to disable the Google button.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional override; defaults to {FRONTEND_ORIGIN}/api/auth/google/callback
GOOGLE_REDIRECT_URI=""

# VPS / public host that user connection strings will point at
VPS_HOST="localhost"

# Docker socket (Dockerode connects here)
DOCKER_SOCKET="/var/run/docker.sock"

# AES-256-GCM key (32 raw bytes, base64-encoded) for per-DB credential encryption
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENC_KEY=""

# Where bind-mounted DB data volumes live on the host
# Prod: /data    Local dev on macOS: an absolute path under /Users that Docker Desktop can mount
DATA_ROOT="/data"

# Nginx TCP routing (Phase 7+)
CUSTOMDB_NETWORK=customdb-network
NGINX_CONTAINER=customdb-nginx
NGINX_STREAM_DIR=/path/to/repo/nginx/stream.d
FRONTEND_ORIGIN=http://localhost:3030

# Express
PORT=4000
NODE_ENV=development

# Password reset email. Use SMTP_URL OR SMTP_HOST/SMTP_PORT/SMTP_USER/SMTP_PASS.
# If omitted, reset links are logged by the backend for local development.
MAIL_FROM="CustomDB <no-reply@example.com>"
SMTP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
