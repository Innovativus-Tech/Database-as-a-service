{
  "name": "@customdb/client",
  "version": "0.1.0",
  "description": "CustomDB client SDK with transparent Redis caching. One connection string, two DB engines.",
  "main": "src/index.js",
  "files": [
    "src",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.js",
    "./mongo": "./src/mongo.js",
    "./postgres": "./src/postgres.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ioredis": "^5.3.0"
  },
  "peerDependencies": {
    "mongodb": ">=5 <8",
    "pg": ">=8 <9"
  },
  "peerDependenciesMeta": {
    "mongodb": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "keywords": [
    "customdb",
    "mongodb",
    "postgres",
    "redis",
    "cache",
    "dbaas"
  ],
  "devDependencies": {
    "mongodb": "^7.4.0",
    "pg": "^8.22.0"
  }
}
